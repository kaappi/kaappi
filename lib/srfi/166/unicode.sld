    (define (%in-ranges? cp ranges)
      (let loop ((rs ranges))
        (and (pair? rs)
             (let ((r (car rs)))
               (if (< cp (car r)) #f
                   (if (<= cp (cdr r)) #t
                       (loop (cdr rs))))))))

    ;; Width of a single codepoint: 0 for non-spacing/format, 2 for wide, 1 or 2
    ;; for ambiguous, 1 otherwise.
    (define (%eaw-width cp ambiguous-is-wide?)
      (cond
        ((%in-ranges? cp %tbl-zero-width) 0)
        ((%in-ranges? cp %tbl-eaw-wide) 2)
        ((%in-ranges? cp %tbl-eaw-ambiguous) (if ambiguous-is-wide? 2 1))
        (else 1)))

    ;; str[i] is ESC.  Skip a CSI sequence ESC [ params... final-byte, or just
    ;; the ESC itself if it is not followed by a '[' introducer.
    (define (%skip-ansi str i end)
      (let ((j (+ i 1)))
        (if (and (< j end) (char=? (string-ref str j) #\[))
            (let loop ((k (+ j 1)))
              (if (>= k end)
                  end
                  (let ((b (char->integer (string-ref str k))))
                    (if (<= 64 b 126)  ; final byte
                        (+ k 1)
                        (loop (+ k 1))))))
            (+ i 1))))

    (define (%unit-width str i end ambiguous-is-wide?)
      (if (char=? (string-ref str i) (integer->char 27))
          (values 0 (%skip-ansi str i end))
          (values (%eaw-width (char->integer (string-ref str i)) ambiguous-is-wide?)
                  (+ i 1))))

    (define (%terminal-width str start end ambiguous-is-wide?)
      (let loop ((i start) (w 0))
        (if (>= i end)
            w
            (call-with-values (lambda () (%unit-width str i end ambiguous-is-wide?))
              (lambda (uw ni) (loop ni (+ w uw)))))))

    (define (%width-index str target len ambiguous-is-wide?)
      (let loop ((i 0) (cum 0))
        (if (>= i len)
            len
            (call-with-values (lambda () (%unit-width str i len ambiguous-is-wide?))
              (lambda (uw ni)
                (let ((cum2 (+ cum uw)))
                  (if (> cum2 target) i (loop ni cum2))))))))

    (define (%substring-by-width str from to ambiguous-is-wide?)
      (let* ((len (string-length str))
             (start (%width-index str from len ambiguous-is-wide?))
             (end (%width-index str to len ambiguous-is-wide?)))
        (substring str start end)))

    (define (string-terminal-width str)
      (%terminal-width str 0 (string-length str) #f))

    (define (string-terminal-width/wide str . o)
      (let ((start (if (pair? o) (car o) 0))
            (end (if (and (pair? o) (pair? (cdr o))) (cadr o) (string-length str))))
        (%terminal-width str start end #t)))

    (define (substring-terminal-width str from to)
      (%substring-by-width str from to #f))

    (define (substring-terminal-width/wide str from to)
      (%substring-by-width str from to #t))

    ;; Preserve only the zero-width ANSI control sequences and directional
    ;; formatting characters, which trimming must not discard.
    (define (%bidi-control? cp)
      (or (<= #x202a cp #x202e)      ; LRE..RLO
          (<= #x2066 cp #x2069)      ; LRI..PDI
          (= cp #x200e) (= cp #x200f)  ; LRM, RLM
          (= cp #x061c)))            ; ALM

    (define (substring-terminal-preserve str)
      (let ((out (open-output-string)))
        (let loop ((i 0) (end (string-length str)))
          (if (>= i end)
              (get-output-string out)
              (let ((c (string-ref str i)))
                (cond
                  ((char=? c (integer->char 27))
                   (let ((j (%skip-ansi str i end)))
                     (write-string (substring str i j) out)
                     (loop j end)))
                  ((%bidi-control? (char->integer c))
                   (write-char c out)
                   (loop (+ i 1) end))
                  (else (loop (+ i 1) end))))))))

    (define (terminal-aware . fmts)
      (fn (ambiguous-is-wide?)
        (with ((string-width (if ambiguous-is-wide?
                                 string-terminal-width/wide
                                 string-terminal-width))
               (substring/width (if ambiguous-is-wide?
                                    substring-terminal-width/wide
                                    substring-terminal-width))
               (substring/preserve substring-terminal-preserve))
          (apply each fmts))))

    ;; Run the formatters with the active state (so string-width and friends
    ;; reach nested formatters), then case-convert the captured output.
    (define (upcased . fmts)
      (call-with-output
        (apply each fmts)
        (lambda (s) (displayed (string-upcase s)))))

    (define (downcased . fmts)
      (call-with-output
        (apply each fmts)
        (lambda (s) (displayed (string-downcase s)))))

    ))
