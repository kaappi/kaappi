.zig-cache/
zig-out/

# Interpreter copies kept in the repo root for A/B runs (build one, stash it
# under a distinct name, rebuild, compare). Root-anchored so they cannot mask
# anything under src/ or tests/.
/kaappi
/pkaappi

.kaappi_history
*.sbc
!src/testdata/*.sbc
*.log
test_*.o
*.dylib
*.so
# zig cc -shared for windows drops these next to the .dll
*.dll
*.pdb
tests/scheme/ffi/fixtures/u64test.lib
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
/coverage/
tools/.cache/
__pycache__/
/site/
